# Copy this file to .env and fill in your values
# cp .env.example .env

# PostgreSQL password (used by both postgres and api services)
POSTGRES_PASSWORD=changeme_strong_password

# JWT signing secret — generate with: openssl rand -hex 32
SECRET_KEY=changeme_jwt_secret_key_32_chars_min

# Optional: restrict CORS origins for the API (comma-separated)
# ALLOWED_ORIGINS=https://yourdomain.com
